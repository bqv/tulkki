    <string name="tulkki_usage_breakdown_one_to_one">A one-to-one conversation</string>
    <string name="tulkki_usage_breakdown_multi_room">Several rooms in one request</string>
    <string name="tulkki_usage_breakdown_deleted">A conversation that is no longer here</string>
