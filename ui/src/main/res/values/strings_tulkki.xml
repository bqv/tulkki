    <!--
      This app's own spend, estimated from its own token counts. It is deliberately not the balance:
      the balance is account-wide and is the truth about what is left, while this is what Tulkki itself
      has spent. DeepSeek has no spend endpoint at all, so this is arithmetic on the usage every
      completion returns, and the screen says so. %1$s is the model the app sends, %2$s the model
      whose published rates these are, %3$s the day the defaults were read off the pricing page.
    -->
    <string name="tulkki_usage_spend_title">This app\u2019s spend (estimated)</string>
    <string name="tulkki_usage_spend_note">Estimated from this app\u2019s own token counts, because DeepSeek reports no spend history. Priced as %1$s at the published %2$s rates of %3$s: peak \u00a5%4$s cache hit, \u00a5%5$s cache miss, \u00a5%6$s output per 1M tokens, and off-peak is %7$s%% of each. Tap a price below to correct it.</string>
    <string name="tulkki_usage_spend_note_derived">Estimated from this app\u2019s own token counts, because DeepSeek reports no spend history. %1$s has no published row in this build, so it is priced from the %2$s row, which is an approximation: peak \u00a5%3$s cache hit, \u00a5%4$s cache miss, \u00a5%5$s output per 1M tokens, and off-peak is %6$s%% of each. Tap a price below to correct it.</string>
    <string name="tulkki_usage_spend_caveat">Each call\u2019s tariff is decided from its own instant in UTC, so the phone\u2019s timezone cannot move a call between peak and off-peak; the day it is filed under is the phone\u2019s own local day, which is not DeepSeek\u2019s Beijing one.</string>
    <string name="tulkki_usage_spend_empty">Nothing recorded yet: no DeepSeek call has been billed to this app.</string>
    <string name="tulkki_usage_spend_total">Total across the %1$d days shown: %2$s</string>
    <string name="tulkki_usage_spend_day_tokens">%1$s tokens \u00b7 hit %2$s \u00b7 miss %3$s \u00b7 out %4$s</string>
    <string name="tulkki_usage_spend_day_hint">Tap a day to see where its tokens went.</string>

