.classpath
*.swp
.settings

git/**/*

# https://github.com/github/gitignore/blob/master/Gradle.gitignore
.gradle/
build/
captures/
# Ignore Gradle GUI config
gradle-app.setting

libs/*.aar
src/main/libs/
src/main/obj/

# Python bytecode from the instruments in tools/ - they are programs, not scripts, and their caches
# are litter that a careless `git add -A` would otherwise commit (PYTHONDONTWRITEBYTECODE, or -B).
__pycache__/
*.pyc

# https://github.com/github/gitignore/blob/master/Android.gitignore
# Built application files
*.apk
*.ap_

# Files for the Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

*.iml
.idea

import-summary.txt
.navigation/
src/main/res/values/api_keys.xml
/.github/ISSUE_TEMPLATE.md

# Tulkki: local toolchain, build serialisation, signing material.
# Nothing here is ever committed - the keystore especially: losing it means the
# app can only ever be reinstalled, never updated in place.
# A lane needs .toolchain and .secrets as symlinks; a trailing slash does not match a symlink.
.toolchain
.build.lock
.install.lock
.device*.lock
.secrets
signing.properties
*.jks
*.keystore

# Gradle/Kotlin daemon state written into the project dir by AGP 9.
.kotlin/

# Icon working files. The finished drop is identity/icon/ and is tracked.
.icon-drafts/

# The emulator harness's disposable state: an AVD copy (2.7G, so a wildcard
# `git add` must never see it), its logs, screenshots and uiautomator dumps.
# tools/emulator.md says what belongs in the commit instead.
.emulator/

# The gate's per-checkout scratch (tools/verify).  Deliberately not .toolchain/verify/: a lane's
# .toolchain is a symlink to the integration checkout's, so two overlapping gate runs would share
# build.ok, failed and the logs and read each other's state.
.verify/

# The migration's working notes, not the app's: kept on disk, kept out of the replay
/docs/
/AGENTS.md

# Our tooling, not the app: a clone builds and tests with ./gradlew, and the lock/pty discipline is this machine's
/tools/
# Our CI config, not the app: no workflow here is needed to build or test a clone
/.github/
# Our store and release metadata, not the app: the build never reads it
/fastlane/
# Bundler manifest for that release automation, not the app
/Gemfile
# Bundler lockfile for that release automation, not the app
/Gemfile.lock
